{
    "version": "0.1.0",
    "name": "@foundry/engine",
    "exports": "./source/engine.ts",
    "imports": {
        "@qwik.dev/core": "npm:@qwik.dev/core@beta",
        "@lume/cli": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.4/cli.ts",
        "@lume/core": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.4/mod.ts",
        "@lume/types": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.4/types.ts",
        "@lume/tailwindcss": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.4/plugins/tailwindcss.ts",
        "@lume/jsx": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.4/plugins/jsx.ts",
        "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.14/jsx-runtime.ts"
    },
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "lume",
        "types": ["@lume/types"],
        "lib": [
            "dom",
            "dom.asynciterable",
            "dom.iterable",
            "deno.ns"
        ]
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120,
        "exclude": ["*.yml", "**/*.yml"]
    },
    "workspace": [
        "./foundry-smp.net"
    ]
}
