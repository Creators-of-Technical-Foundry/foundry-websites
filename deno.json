{
    "nodeModulesDir": "auto",
    "workspace": [
        "./engine",
        "./theme",
        "./modules",
        "./domains/foundry-smp.net",
        "./domains/foundry-modpack.link"
    ],
    "imports": {
        "@adaliszk/std": "npm:@adaliszk/std@latest",
        "@qwik.dev/core": "npm:@qwik.dev/core@beta",
        "@hono/hono": "jsr:@hono/hono@4.12.18",
        "vite": "npm:vite@7.3.3"
    },
    "allowScripts": ["npm:esbuild@0.27.7", "npm:sharp@0.34.5"],
    "compilerOptions": {
        "jsx": "preserve",
        "jsxFragmentFactory": "Fragment",
        "jsxImportSource": "@hono/hono/jsx",
        "lib": [
            "dom",
            "dom.asynciterable",
            "dom.iterable",
            "deno.ns"
        ],
        "types": [
            "vite/client"
        ]
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120
    }
}
