# Defaults
**/* text=auto eol=lf
# Configure algorithm for diff
**/*.md diff=markdown
**/*.html diff=html
**/*.css diff=css
# LFS tracking
**/*.css filter=lfs diff=lfs merge=lfs -text
**/*.png filter=lfs diff=lfs merge=lfs -text
**/*.svg filter=lfs diff=lfs merge=lfs -text
**/*.ttf filter=lfs diff=lfs merge=lfs -text
